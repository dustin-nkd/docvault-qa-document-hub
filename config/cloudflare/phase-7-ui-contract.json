{
  "schema_version": 1,
  "phase": "CF-P7",
  "story": "CF-P7-001",
  "status": "FROZEN",
  "exit_gate": "P7-G1",
  "frozen_on": "2026-07-26",
  "amendment_rule": "This contract is frozen. Any change requires a new story, a recorded reason, and a passing cf:phase7:contract:check; a surface, state, or mapping may not be added or removed as an implementation detail.",

  "surfaces": [
    { "id": "account-menu", "owner": "CF-P7-003", "scope": "account",
      "base_states": ["loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["view-identity", "sign-out"] },
    { "id": "workspace-switcher", "owner": "CF-P7-003", "scope": "account",
      "base_states": ["empty", "loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["list-workspaces", "switch-workspace", "open-create-workspace"] },
    { "id": "create-workspace", "owner": "CF-P7-004", "scope": "account",
      "base_states": ["loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["name-workspace", "bootstrap-key", "create"] },
    { "id": "device-key-initialization", "owner": "CF-P7-005", "scope": "account",
      "base_states": ["empty", "loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["register-device", "show-fingerprint", "await-provisioning", "revoke-device"] },
    { "id": "member-list-role-badge", "owner": "CF-P7-006", "scope": "workspace",
      "base_states": ["empty", "loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["list-members", "show-role-badge", "show-key-readiness"] },
    { "id": "invitation-manage", "owner": "CF-P7-007", "scope": "workspace",
      "base_states": ["empty", "loading", "unauthorized", "error"],
      "roles": ["owner", "admin"],
      "actions": ["create-invitation", "copy-acceptance-link", "revoke-invitation"] },
    { "id": "invitation-accept", "owner": "CF-P7-008", "scope": "account",
      "base_states": ["loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["review-invitation", "accept-invitation"] },
    { "id": "sync-state", "owner": "CF-P7-009", "scope": "workspace",
      "base_states": ["loading", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["announce-state"] },
    { "id": "conflict-dialog", "owner": "CF-P7-010", "scope": "workspace",
      "base_states": ["loading", "error"],
      "roles": ["owner", "admin", "editor"],
      "actions": ["review-latest", "reapply-to-latest", "save-as-separate-copy", "discard-with-confirmation"] },
    { "id": "audit-activity", "owner": "CF-P7-011", "scope": "workspace",
      "base_states": ["empty", "loading", "unauthorized", "error"],
      "roles": ["owner", "admin"],
      "actions": ["list-audit-events", "paginate"] },
    { "id": "base-states", "owner": "CF-P7-002", "scope": "shared",
      "base_states": ["empty", "loading", "unauthorized", "error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["render-state"] },
    { "id": "github-pages-banner", "owner": "CF-P7-002", "scope": "deployment",
      "base_states": ["error"],
      "roles": ["owner", "admin", "editor", "viewer"],
      "actions": ["announce-collaboration-unavailable"] }
  ],

  "sync_state_machine": {
    "states": ["Saved", "Saving", "Offline", "Conflict", "Access removed"],
    "initial": "Saved",
    "terminal": ["Access removed"],
    "sources": {
      "Saved": "the outbox holds no entry for the open document, or its last entry reached applied",
      "Saving": "an outbox entry for the open document is queued or inflight",
      "Offline": "the transport is unavailable or the browser reports offline while at least one entry is queued",
      "Conflict": "a mutation returned DOCUMENT_REVISION_CONFLICT",
      "Access removed": "a workspace-scoped call was denied and a membership re-check shows the user is no longer an active member of that workspace"
    },
    "transitions": [
      { "from": "Saved", "to": "Saving" },
      { "from": "Saving", "to": "Saved" },
      { "from": "Saving", "to": "Offline" },
      { "from": "Saving", "to": "Conflict" },
      { "from": "Saving", "to": "Access removed" },
      { "from": "Offline", "to": "Saving" },
      { "from": "Offline", "to": "Access removed" },
      { "from": "Conflict", "to": "Saving" },
      { "from": "Conflict", "to": "Saved" },
      { "from": "Conflict", "to": "Access removed" }
    ],
    "rules": [
      "Access removed is terminal for the open document; recovery is re-entry through the workspace switcher, never an in-place retry.",
      "Conflict is never left automatically; only an explicit resolution from the frozen set moves out of it.",
      "No state is signalled by colour alone; each carries a text label and a distinct shape or icon."
    ]
  },

  "error_mapping": [
    { "code": "UNAUTHENTICATED", "ui": "unauthorized", "explains_reason": true },
    { "code": "OPERATION_NOT_PERMITTED", "ui": "role-disabled-explanation", "explains_reason": true },
    { "code": "RECENT_AUTHENTICATION_REQUIRED", "ui": "unauthorized", "explains_reason": true },
    { "code": "DOCUMENT_REVISION_CONFLICT", "ui": "Conflict", "explains_reason": true },
    { "code": "KEY_VERSION_MISMATCH", "ui": "error", "explains_reason": true },
    { "code": "IDEMPOTENCY_KEY_REUSED", "ui": "error", "explains_reason": true },
    { "code": "IDEMPOTENCY_WINDOW_EXPIRED", "ui": "error", "explains_reason": true },
    { "code": "RESOURCE_NOT_FOUND", "ui": "empty-or-access-removed", "explains_reason": true },
    { "code": "RATE_LIMITED", "ui": "error", "explains_reason": true },
    { "code": "COLLABORATION_UNAVAILABLE", "ui": "error", "explains_reason": true },
    { "code": "VALIDATION_FAILED", "ui": "error", "explains_reason": true },
    { "code": "CSRF_REJECTED", "ui": "error", "explains_reason": true }
  ],

  "inherited_vocabularies": {
    "conflict_resolutions": ["review-latest", "reapply-to-latest", "save-as-separate-copy",
      "discard-with-confirmation"],
    "conflict_states": ["unresolved", "reviewing", "resolved", "discarded"],
    "outbox_states": ["queued", "inflight", "applied", "terminal", "expired", "quarantined"],
    "roles": ["owner", "admin", "editor", "viewer"],
    "source": "Frozen by CF-P6-001 and CF-P6-007; Phase 7 renders these and may not extend them."
  },

  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "focus_indicator_min_contrast": 3,
    "focus_visible_required": true,
    "focus_trap_permitted": false,
    "dialog_focus_moved_on_open": true,
    "dialog_focus_restored_on_close": true,
    "state_signalled_by_colour_alone": false,
    "disabled_control_pattern": "visible, aria-disabled or disabled, with a programmatically associated text reason",
    "live_region_for_sync_state": "polite",
    "minimum_target_size_px": 24
  },

  "responsive": {
    "minimum_width_px": 320,
    "breakpoints_px": [320, 768, 1024],
    "horizontal_page_scroll_permitted": false,
    "clipped_or_overlapping_controls_permitted": false,
    "long_name_strategy": "truncate with an accessible full value, never overflow the container"
  },

  "separation": {
    "personal_record_on_workspace_surface": "prohibited",
    "workspace_record_on_personal_surface": "prohibited",
    "collaboration_modules_on_personal_startup": 0,
    "personal_writes_from_collaboration_path": 0,
    "active_workspace_visible_on_every_workspace_surface": true,
    "active_workspace_survives_reload": true
  }
}
