  "sprint_gate_scenarios": [
    {
      "id": "G1",
      "scenario": "Personal documents unchanged",
      "required": "byte-for-byte identical to pre-refactor characterization baseline; zero personal writes from any collaboration path"
    },
    {
      "id": "G2",
      "scenario": "Editor creates and Viewer reads",
      "required": "create 201 at revision 1; Viewer reads current document and revision history"
    },
    {
      "id": "G3",
      "scenario": "Viewer cannot write via API",
      "required": "authorization denial with zero document, revision, idempotency, and business audit rows"
    },
    {
      "id": "G4",
      "scenario": "Two browsers edit the same revision",
      "required": "exactly one revision advance; the other receives 409 DOCUMENT_REVISION_CONFLICT and retains its draft"
    },
    {
      "id": "G5",
      "scenario": "Network retry",
      "required": "exactly one revision, one idempotency result, and one audit event"
    },
    {
      "id": "G6",
      "scenario": "Offline mutation replay",
      "required": "queued mutation re-authorized on submission produces exactly one revision; changed authority quarantines instead"
    }
  ],
