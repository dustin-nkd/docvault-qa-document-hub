  "secret_handling": {
    "token_bits_minimum": 256,
    "returned_once": true,
    "recoverable": false,
    "fragment_only": true,
    "query_string_rejected": true,
    "rendered_into_anchor": false,
    "stored_anywhere": false,
    "logged": false,
    "clearable_by_caller": true,
    "clipboard_injected": true,
    "blocked_clipboard_explains_manual_path": true,
    "rationale": "The acceptance token has at least 256 random bits, is returned exactly once, lives only in a URL fragment so it never reaches the server in a request line, referrer, or proxy log, and is stored server-side only as a digest. It cannot be recovered, so the surface says so while the value is on screen. It renders into a readonly input rather than an anchor because activating a link would push the secret into browser history, which is exactly what the fragment placement exists to avoid."
  },
