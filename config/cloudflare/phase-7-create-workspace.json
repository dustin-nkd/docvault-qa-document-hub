  "journey": {
    "steps": ["name-workspace", "bootstrap-key", "create"],
    "statuses": ["naming", "binding", "sealing", "creating", "created", "failed"],
    "intent_precedes_key_material": true,
    "single_idempotency_key_for_both_calls": true,
    "retry_reuses_original_key": true,
    "automatic_retry": false,
    "workspace_id_derived_by_server": true,
    "binding_device_compared_before_sealing": true,
    "created_workspace_id_compared_before_selection": true,
    "rationale": "The client seals the creator envelope only after the bootstrap intent returns the binding, because the envelope is bound to a workspace id, key version, and device fingerprint the server chooses. One idempotency key covers both calls and a retry reuses it: a create that fails after the mutation reached D1 looks identical to one that failed before it, so a fresh key would read as a second request and could leave the user with a workspace they never asked for."
  },
